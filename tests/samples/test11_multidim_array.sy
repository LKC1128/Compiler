int a[2][3] = {{1, 2, 3}, {4, 5, 6}};

int sum_matrix(int m[][3], int rows) {
    int total = 0;
    int i = 0;
    while (i < rows) {
        int j = 0;
        while (j < 3) {
            total = total + m[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

int main() {
    int s = sum_matrix(a, 2);
    putint(s);
    putch(10);
    return s;
}
