// 测试8: 张量减法和一元负号
int main() {
    tensor int a[4] = {1, 2, 3, 4};
    tensor int b[4] = {5, 6, 7, 8};
    tensor int c[4];
    tensor int d[4];

    c = b - a;
    d = -c;

    putint(c[0]);
    putch(32);
    putint(c[1]);
    putch(32);
    putint(c[2]);
    putch(32);
    putint(c[3]);
    putch(10);

    putint(d[0]);
    putch(32);
    putint(d[1]);
    putch(32);
    putint(d[2]);
    putch(32);
    putint(d[3]);
    putch(10);

    return 0;
}
