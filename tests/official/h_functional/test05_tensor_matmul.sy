// 测试5: 张量矩阵乘法 @
int main() {
    tensor int A[2][3] = {{1, 2, 3}, {4, 5, 6}};
    tensor int B[3][2] = {{7, 8}, {9, 10}, {11, 12}};
    tensor int C[2][2];

    C = A @ B;

    putint(C[0][0]);
    putch(32);
    putint(C[0][1]);
    putch(10);
    putint(C[1][0]);
    putch(32);
    putint(C[1][1]);
    putch(10);

    return 0;
}
