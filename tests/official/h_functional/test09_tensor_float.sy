// 测试9: 浮点张量运算，使用程序内判断
float fabs_custom(float x) {
    if (x < 0.0) return -x;
    return x;
}

int main() {
    tensor float a[3] = {1.5, 2.5, 3.5};
    tensor float b[3] = {0.5, 1.0, 1.5};
    tensor float c[3];

    c = a + b;

    // 期望值: 2.0, 3.5, 5.0
    float expected[3];
    expected[0] = 2.0;
    expected[1] = 3.5;
    expected[2] = 5.0;

    float tolerance = 0.0001;
    int all_correct = 1;

    int i = 0;
    while (i < 3) {
        float diff = fabs_custom(c[i] - expected[i]);
        if (diff > tolerance) {
            all_correct = 0;
        }
        i = i + 1;
    }

    if (all_correct) {
        putint(1);
    } else {
        putint(0);
    }
    putch(10);

    return 0;
}
