// 测试3: 张量与标量运算（标量提升）
int main() {
    tensor int a[4] = {1, 2, 3, 4};
    tensor int b[4] = {5, 6, 7, 8};
    tensor int c[4];

    c = a + b * 2 + 10;

    putint(c[0]);
    putch(32);
    putint(c[1]);
    putch(32);
    putint(c[2]);
    putch(32);
    putint(c[3]);
    putch(10);

    return 0;
}
