tensor int a[524288];
tensor int b[524288];
tensor int c[524288];

int main() {
    int seed = getint();
    int i = 0;
    while (i < 524288) {
        a[i] = (i + seed) % 97;
        b[i] = (i * 3 + seed * 5) % 89;
        i = i + 1;
    }

    starttime();
    c = a + b * 3 - 7;

    int bad = 0;
    int round = 0;
    while (round < 3060) {
        i = 0;
        while (i < 524288) {
            int expected = a[i] + b[i] * 3 - 7;
            if (c[i] != expected) {
                bad = bad + 1;
            }
            i = i + 1;
        }
        round = round + 1;
    }

    stoptime();
    if (bad == 0) {
        putint(1);
    } else {
        putint(0);
    }
    putch(10);
    return 0;
}
