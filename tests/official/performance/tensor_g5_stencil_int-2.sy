tensor int current[640][640];
tensor int next[640][640];

int main() {
    int seed = getint();
    int i = 0;
    while (i < 640) {
        int j = 0;
        while (j < 640) {
            current[i][j] = seed + 3;
            j = j + 1;
        }
        i = i + 1;
    }

    starttime();
    int round = 0;
    while (round < 1080) {
        i = 0;
        while (i < 640) {
            int up = i - 1;
            int down = i + 1;
            if (up < 0) {
                up = 640 - 1;
            }
            if (down == 640) {
                down = 0;
            }
            int j = 0;
            while (j < 640) {
                int left = j - 1;
                int right = j + 1;
                if (left < 0) {
                    left = 640 - 1;
                }
                if (right == 640) {
                    right = 0;
                }
                next[i][j] = (current[up][j] + current[down][j] + current[i][left] + current[i][right]) / 4 + 1;
                j = j + 1;
            }
            i = i + 1;
        }

        i = 0;
        while (i < 640) {
            int j = 0;
            while (j < 640) {
                current[i][j] = next[i][j];
                j = j + 1;
            }
            i = i + 1;
        }
        round = round + 1;
    }

    int expected = seed + 3 + 1080;
    stoptime();
    if (current[0][0] == expected && current[320][320] == expected && current[639][639] == expected) {
        putint(1);
    } else {
        putint(0);
    }
    putch(10);
    return 0;
}
