// Dijkstra's Shortest Path Algorithm (浮点版本)
float dist[2048];
int visited[2048];
float graph[2048][2048];

float INF_F = 1000000.0;

void dijkstra(int n, int src) {
    int i = 0;
    while (i < n) {
        dist[i] = INF_F;
        visited[i] = 0;
        i = i + 1;
    }
    dist[src] = 0.0;

    int count = 0;
    while (count < n) {
        float min_dist = INF_F;
        int u = -1;
        i = 0;
        while (i < n) {
            if (visited[i] == 0 && dist[i] < min_dist) {
                min_dist = dist[i];
                u = i;
            }
            i = i + 1;
        }

        if (u == -1) break;
        visited[u] = 1;

        int v = 0;
        while (v < n) {
            if (visited[v] == 0 && graph[u][v] < INF_F) {
                float new_dist = dist[u] + graph[u][v];
                if (new_dist < dist[v]) {
                    dist[v] = new_dist;
                }
            }
            v = v + 1;
        }
        count = count + 1;
    }
}

float fabs_custom(float x) {
    if (x < 0.0) return -x;
    return x;
}

int main() {
    int n = getint();
    int seed = getint();

    starttime();

    int i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            if (i == j) {
                graph[i][j] = 0.0;
            } else {
                int val = (i * 17 + j * 23 + seed) % 100;
                if (val < 70) {
                    graph[i][j] = (val + 1) * 1.0 / 10.0;
                } else {
                    graph[i][j] = INF_F;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    int rep = 0;
    while (rep < 51) {
        dijkstra(n, 0);
        rep = rep + 1;
    }

    float sum = 0.0;
    i = 0;
    while (i < n) {
        if (dist[i] < INF_F) {
            sum = sum + dist[i];
        }
        i = i + 1;
    }

    stoptime();

    float expected = 1283.6;
    float diff = fabs_custom(sum - expected);
    float tolerance = expected * 0.001;

    int result = 0;
    if (diff <= tolerance) {
        result = 1;
    }

    putint(result);
    putch(10);
    return 0;
}
