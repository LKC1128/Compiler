// LCS - Longest Common Subsequence using DP
int dp[2048][2048];
int a[2048];
int b[2048];

int max(int x, int y) {
    if (x > y) return x;
    return y;
}

int lcs(int n, int m) {
    int i = 0;
    while (i <= n) {
        int j = 0;
        while (j <= m) {
            dp[i][j] = 0;
            j = j + 1;
        }
        i = i + 1;
    }

    i = 1;
    while (i <= n) {
        int j = 1;
        while (j <= m) {
            if (a[i-1] == b[j-1]) {
                dp[i][j] = dp[i-1][j-1] + 1;
            } else {
                dp[i][j] = max(dp[i-1][j], dp[i][j-1]);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return dp[n][m];
}

int main() {
    int n = getarray(a);
    int m = getarray(b);

    starttime();

    int result = 0;
    int iter = 0;
    while (iter < 630) {
        result = result + lcs(n, m);
        iter = iter + 1;
    }

    stoptime();

    putint(result);
    putch(10);
    return 0;
}
