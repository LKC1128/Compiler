int main(){tensor int a[4][4]={{4,0,3,-2},{-4,-4,3,5},{0,4,4,-1},{-3,3,2,4}};tensor int b[4][4]={{-2,-2,3,-1},{5,-4,5,2},{4,5,1,-3},{-2,2,1,-4}};a=a@b;b=b@a;putarray(4,a[0]);putarray(4,a[1]);putarray(4,a[2]);putarray(4,a[3]);putarray(4,b[0]);putarray(4,b[1]);putarray(4,b[2]);putarray(4,b[3]);return 0;}
