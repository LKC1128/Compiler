int main(){tensor int a[4][4]={{-4,3,-4,-1},{-4,-2,0,4},{4,4,1,-4},{0,3,-4,-3}};tensor int b[4][4]={{-4,0,5,5},{-4,-4,4,-4},{2,4,0,2},{-4,3,1,-1}};a=a@b;b=b@a;putarray(4,a[0]);putarray(4,a[1]);putarray(4,a[2]);putarray(4,a[3]);putarray(4,b[0]);putarray(4,b[1]);putarray(4,b[2]);putarray(4,b[3]);return 0;}
